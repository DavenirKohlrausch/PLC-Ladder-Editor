<UserControl x:Class="CustomUserControls.CustomTitleBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Height="40" MinHeight="32">
    <Border Background="SteelBlue" CornerRadius="8,8,0,0"  MouseDown="TitleBar_MouseDown">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- Ícone -->
            <Image Source="/CustomUserControls;component/Images/Img__OK.png" Width="24" Height="24" Margin="8,0"/>
            <!-- Título -->
            <TextBlock Grid.Column="1" Text="Minha Aplicação" VerticalAlignment="Center" Foreground="White" FontWeight="Bold" FontSize="16"/>
            <!-- Botões -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="—" Width="32" Height="32" Margin="0,0,4,0" Click="Minimize_Click"/>
                <Button Content="[ ]" Width="32" Height="32" Margin="0,0,4,0" Click="Maximze_Click"/>
                <Button Content="X" Width="32" Height="32" Margin="0,0,4,0" Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>